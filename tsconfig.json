{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "types": ["node", "vscode"],
    "sourceMap": true,
    "rootDir": "src",
    "strictNullChecks": true,
    "allowJs": false,
    "noImplicitAny": false,
    "strict": false
